DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── AI Assistant (optional) ────────────────────────────────────────────────
# Plug in ANY OpenAI-compatible model provider. While AI_API_TOKEN is left at
# its placeholder value, the built-in fallback provider is used automatically.
#   AI_API_BASE_URL  – e.g. https://api.openai.com/v1 | https://api.groq.com/openai/v1
#                       | https://openrouter.ai/api/v1 | http://localhost:11434/v1 (Ollama)
#   AI_API_TOKEN     – your secret bearer token (never shipped to the client)
#   AI_MODEL         – e.g. gpt-4o-mini | llama-3.3-70b-versatile | deepseek-chat
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_TOKEN=your-api-token-here
AI_MODEL=gpt-4o-mini
