// ASM — Arabian Shield Manpower
// Rewritten Prisma schema (SQLite)
// Design goals:
//   1. Explicit foreign-key relations between all related tables.
//   2. Consistent soft-delete via `deletedAt` on every data model so deletion
//      can be cascaded across tables WITHOUT ever hard-deleting rows.
//   3. Per-employee "custom current total working hours" that can be set at any
//      point in time (Employee.currentTotalWorkingHours).
// Legacy soft-delete flags (status='deleted', isHidden, isDeleted, deletedDate)
// are retained for backward compatibility with existing queries; the canonical
// soft-delete marker is now `deletedAt`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin") // "super_admin" or "admin"
  theme     String   @default("dark") // "dark" or "light"
  // Heartbeat timestamp updated periodically by the client while the app is
  // open. Used by the Admin Management page to show an online indicator.
  // A user is considered "online" if lastSeenAt is within the last 90s.
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  notifications                Notification[]
  leaveRequestsCreated         LeaveRequest[]       @relation("CreatedBy")
  leaveRequestsReviewed        LeaveRequest[]       @relation("ReviewedBy")
  cancellationRequestsCreated  CancellationRequest[] @relation("RequestedBy")
  cancellationRequestsReviewed CancellationRequest[] @relation("ReviewedBy")
  warnings                     Warning[]
  fines                        Fine[]
  actedNotifications           Notification[]        @relation("NotificationActor")
  appSettingsUpdated           AppSetting[]
  menuPermissions              AdminMenuPermission[]
  adminPermissions             AdminPermission[]
  attendanceVersions           AttendanceVersion[]
  activityLogs                 ActivityLog[]
  aiChatSessions               AiChatSession[]
}

model AdminMenuPermission {
  id        String   @id @default(cuid())
  userId    String
  menuKey   String // e.g. "employees", "sites", "attendance", "leave_requests", "cancellation_requests", "notifications"
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, menuKey])
  @@index([userId])
}

model Employee {
  id               String    @id @default(cuid())
  fullName         String
  employeeId       String    @unique
  nationality      String?
  dateOfBirth      DateTime?
  phone            String?
  email            String?
  address          String?
  emergencyContact String?
  position         String? // Legacy - kept for backward compat
  trade            String? // New: Trade (Mason, Electrician, Welder, etc.)
  joinDate         DateTime?
  companyName      String?
  passportNumber   String?
  passportStatus   String?
  idNumber         String?
  idStatus         String?
  currentSite      String? // Denormalized site NAME (kept for backward compat with existing queries)
  currentSiteId    String? // FK -> Site.id (proper relation)
  rating           Float     @default(0)
  status           String    @default("active") // "active", "deleted", "pending_deletion"
  photo            String?
  isTeamLeader     Boolean   @default(false)
  teamLeaderSiteId String? // FK -> Site.id
  isSupervisor     Boolean   @default(false)
  supervisorSiteId String? // FK -> Site.id
  role             String    @default("Standard") // "Standard", "Team Leader", "Supervisor"
  customHourlyRate Float? // Nullable - overrides standard tier rates for this employee
  hoursThreshold   Int       @default(1000) // Hours threshold for rate switching (basic vs premium)
  isTeko           Boolean  @default(false) // If true, this employee is a "teko" (using another employee's ID)
  branchId         String?  // FK to Branch — which branch this employee belongs to
  campId           String?  // FK to Camp — which camp the employee lives in
  bedSpaceNumber   String?  // Bed space number inside the assigned camp (editable from the camp detail table)
  // Custom current total working hours — manually settable at ANY point in time.
  // Represents the employee's running cumulative total hours and can be overridden
  // by an admin whenever needed (e.g. to correct historical data).
  currentTotalWorkingHours Float   @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  deletedAt                DateTime?
  // Explicit recycle-bin flag (mirrors deletedAt): true = sitting in the Recycle Bin,
  // false = live. Kept in sync by cascadeSoftDeleteEmployee / restoreSoftDeletedEmployee.
  isDeleted                Boolean  @default(false)

  // Relations
  currentSiteRef  Site?  @relation("EmployeeCurrentSite", fields: [currentSiteId], references: [id])
  teamLeaderSite  Site?  @relation("EmployeeTeamLeaderSite", fields: [teamLeaderSiteId], references: [id])
  supervisorSite  Site?  @relation("EmployeeSupervisorSite", fields: [supervisorSiteId], references: [id])
  branch          Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  camp            Camp?   @relation(fields: [campId], references: [id], onDelete: SetNull)
  attendance           Attendance[]
  warnings             Warning[]
  fines                Fine[]
  leaveRequests        LeaveRequest[]
  cancellationRequests CancellationRequest[]
  uniformRegistry      UniformRegistry[]
  siteHistory          EmpCountSitePerMonth[]
  salaryRecords        SalaryRecord[]
  workingHours         TotalEmployeeWorkingHours[]
  workLogs             WorkLog[]
  advances             Advance[]
  employeeTrade        EmployeeTrade?
  rateChangelogs       EmployeeRateChangelog[]
  documents            EmployeeDocument[]

  @@index([trade])
  @@index([status])
  @@index([isTeamLeader])
  @@index([isSupervisor])
  @@index([currentSite])
  @@index([currentSiteId])
  @@index([branchId])
  @@index([campId])
  @@index([isTeko])
  @@index([fullName])
  @@index([passportNumber])
  @@index([companyName])
}

// ---------------------------------------------------------------------------
// EmployeeRateChangelog — per-month rate history
// ---------------------------------------------------------------------------
// When an admin sets a custom hourly rate for an employee, a changelog entry
// is created with an `effectiveMonth` (YYYY-MM). The rate applies to that
// month and all future months UNTIL the next changelog entry's effectiveMonth.
//
// Past months (before this entry's effectiveMonth) keep whatever rate was
// effective at that time (from an earlier changelog entry, or the employee's
// default role/trade rate if no earlier entry exists).
//
// Resolution at query time:
//   For a given (employeeId, monthKey), find the changelog entry with the
//   LARGEST effectiveMonth that is <= monthKey. If found, that entry's
//   `rate` overrides the employee's customHourlyRate for that month.
//
// This is what makes past months "frozen" at their old rate while future
// months use the new rate — the recalculation engine reads from this table
// per-month instead of using a single global rate for all months.
// ---------------------------------------------------------------------------
model EmployeeRateChangelog {
  id             String   @id @default(cuid())
  employeeId     String
  rate           Float    // the custom hourly rate (AED/hr)
  effectiveMonth String   // YYYY-MM — first month this rate applies
  reason         String   @default("") // optional note from admin
  createdBy      String?  // admin name/userId who made the change
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, effectiveMonth]) // one change per month per employee
  @@index([employeeId, effectiveMonth])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Branch
// ---------------------------------------------------------------------------
// A Branch is a regional/organisational division of the company. Each branch
// has its own set of sites and employees. The same client can appear in
// different branches. Employees normally work within their branch but can
// (rarely) be assigned to a site in another branch.
// ---------------------------------------------------------------------------
model Branch {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "Riyadh Branch", "Jeddah Branch"
  code      String?  // Short code e.g. "RYD", "JED"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  sites      Site[]
  employees  Employee[]

  @@index([isActive])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Camp
// ---------------------------------------------------------------------------
// A Camp is an accommodation facility where employees live. Each camp has a
// fixed number of bed spaces. Employees are assigned to a camp (one camp
// per employee at a time). The camp page shows occupancy stats (total,
// occupied, available) as a pie chart and lists all employees in the camp.
// ---------------------------------------------------------------------------
model Camp {
  id            String   @id @default(cuid())
  name          String   @unique
  location      String?
  totalBedSpaces Int     @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  employees Employee[]

  @@index([isActive])
  @@index([deletedAt])
}

model Site {
  id          String   @id @default(cuid())
  name        String   @unique
  clientName  String?
  projectName String?
  projectId   String? // Free-text project ID (e.g. client's internal project code)
  branchId    String?  // FK to Branch — which branch this site belongs to
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Back-relations for the Employee -> Site FKs
  currentEmployees Employee[] @relation("EmployeeCurrentSite")
  teamLeaders      Employee[] @relation("EmployeeTeamLeaderSite")
  supervisors      Employee[] @relation("EmployeeSupervisorSite")

  employeeHistory   EmpCountSitePerMonth[]
  monthActivations  SiteMonthActivation[]
  workLogs          WorkLog[]
  salaryRecords     SalaryRecord[]
  attendanceShares  AttendanceShare[]
  attendanceVersions AttendanceVersion[]
  attendanceRecords  Attendance[]
}

model Attendance {
  id            String   @id @default(cuid())
  employeeId    String
  siteId        String?  // FK to Site — which site this attendance belongs to
  date          String // YYYY-MM-DD format
  status        String   @default("present") // "present", "absent", "no_site", "overtime", "camp_sitting", "not_marked"
  overtimeHours Float?
  isHidden      Boolean  @default(false) // Legacy soft-hide when employee is deleted
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site     Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([siteId])
  @@index([date])
  @@index([isHidden])
  @@index([deletedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String // "request", "warning", "fine"
  read      Boolean  @default(false)
  // The user who CAUSED this notification (e.g. the admin who issued a
  // warning/fine or submitted a request). Null for system-generated events.
  // Lets the UI show a correct "Issued by <name>" on every card.
  actorId   String?
  isHidden  Boolean  @default(false) // Legacy soft-hide
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([isHidden])
  @@index([deletedAt])
}

// Global app settings (key → value) managed from the Settings page by the
// super admin. Applied across ALL pages via the client settings store —
// e.g. the display currency used by every money amount in the app.
model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique // "currency", "companyName", ...
  value       String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model Warning {
  id              String    @id @default(cuid())
  employeeId      String
  reason          String
  isAutoGenerated Boolean   @default(false)
  absentDates     String? // JSON string of dates
  customDate      DateTime? // Custom date if provided, otherwise createdAt is used
  isHidden        Boolean   @default(false) // Legacy soft-hide
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([employeeId])
  @@index([isHidden])
  @@index([deletedAt])
}

model Fine {
  id         String    @id @default(cuid())
  employeeId String
  reason     String
  amount     Float
  customDate DateTime? // Custom date if provided, otherwise createdAt is used
  isHidden   Boolean   @default(false) // Legacy soft-hide
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([employeeId])
  @@index([isHidden])
  @@index([deletedAt])
}

model LeaveRequest {
  id            String    @id @default(cuid())
  employeeId    String
  leaveType     String // "casual", "sick", "annual", "emergency", "marriage", "other"
  otherTypeText String? // Free-text when leaveType is "other"
  startDate     DateTime
  endDate       DateTime
  totalDays     Int
  reason        String
  status        String    @default("pending") // "pending", "approved", "rejected"
  isHidden      Boolean   @default(false) // Legacy soft-hide
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviewedAt    DateTime?
  deletedAt     DateTime?

  employee     Employee @relation(fields: [employeeId], references: [id])
  createdById  String
  createdBy    User     @relation("CreatedBy", fields: [createdById], references: [id])
  reviewedById String?
  reviewedBy   User?    @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
  @@index([isHidden])
  @@index([deletedAt])
}

model CancellationRequest {
  id             String    @id @default(cuid())
  employeeId     String
  reason         String?
  status         String    @default("pending") // "pending", "approved", "rejected"
  customDate     DateTime? // Custom date if provided, otherwise createdAt is used
  isHidden       Boolean   @default(false) // Legacy soft-hide
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  reviewedAt     DateTime?
  deletedAt      DateTime?

  employee      Employee @relation(fields: [employeeId], references: [id])
  requestedById String
  requestedBy   User     @relation("RequestedBy", fields: [requestedById], references: [id])
  reviewedById  String?
  reviewedBy    User?    @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
  @@index([isHidden])
  @@index([deletedAt])
}

model UniformRegistry {
  id              String   @id @default(cuid())
  uniformId       Int      @unique // Auto-assigned in the POST route (max + 1)
  tokenNumber     Int
  employeeName    String
  employeeId      String
  documentType    String // "id" or "passport"
  documentNumber  String // Stored encrypted
  items           String // JSON string
  sizes           String?  // JSON string of item sizes, e.g. {"uniform":"L","shoes":"42"}
  siteName        String?
  teamLeaderName  String?
  isRenewal       Boolean  @default(false)
  previousTokenId String? // reference to previous token if this is a renewal
  isDeleted       Boolean  @default(false) // Legacy soft-delete
  isHidden        Boolean  @default(false) // Legacy soft-hide
  createdAt       DateTime @default(now())
  renewalDate     DateTime // 6 months from createdAt
  deletedAt       DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([tokenNumber])
  @@index([createdAt])
  @@index([uniformId])
  @@index([isHidden])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// StockItem
// ---------------------------------------------------------------------------
// Tracks the available stock of each material (uniform, shoes, helmet, etc.)
// by size. When a token is issued, the corresponding stock is decremented.
// Admins can add/replenish stock at any time.
// ---------------------------------------------------------------------------
model StockItem {
  id          String   @id @default(cuid())
  itemName    String   // e.g. "Uniform", "Shoes", "Helmet", "Water Bottle"
  size        String?  // e.g. "S", "M", "L", "XL", "42", "43", "One Size"
  quantity    Int      @default(0)
  minQuantity Int      @default(0) // Low-stock threshold for alerts
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@unique([itemName, size])
  @@index([itemName])
  @@index([deletedAt])
}

model Permission {
  id        String   @id @default(cuid())
  name      String   @unique // Display name: "Dashboard", "Employees", etc.
  slug      String   @unique // URL key: "dashboard", "employees", etc.
  group     String   @default("general") // Permission group
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  adminPermissions AdminPermission[]

  @@index([slug])
  @@index([group])
}

model AdminPermission {
  id           String   @id @default(cuid())
  adminId      String
  permissionId String
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  admin      User       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([adminId, permissionId])
  @@index([adminId])
  @@index([permissionId])
}

model TotalEmployeeWorkingHours {
  id                String   @id @default(cuid())
  empId             String // FK to Employee
  empName           String
  month             String // YYYY-MM format - which month these hours belong to
  totalWorkingHours Float    @default(0) // hours for this specific month
  rtPerHour         Float    @default(2.5) // rate per hour for this month
  isCustom          Boolean  @default(false) // if true, rtPerHour is manually set
  isDeleted         Boolean  @default(false) // Legacy soft-delete
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  employee Employee @relation(fields: [empId], references: [id], onDelete: Cascade)

  @@unique([empId, month])
  @@index([empId])
  @@index([month])
  @@index([isDeleted])
  @@index([deletedAt])
}

model SalaryRecord {
  id            String   @id @default(cuid())
  empId         String // FK to Employee
  empName       String
  siteId        String // FK to Site
  siteName      String
  month         String // YYYY-MM format
  year          Int
  nationality   String   @default("")
  trade         String   @default("")
  employeeCode  String   @default("") // employeeId (e.g. ASM-001)
  slNo          Int      @default(0)
  totalHours    Float    @default(0)
  rtPerHour     Float    @default(2.5)
  totalSalary   Float    @default(0)
  deduction     Float    @default(0)
  advance       Float    @default(0)
  balanceSalary Float    @default(0)
  isPaid        Boolean  @default(false)
  isDeleted     Boolean  @default(false) // Legacy soft-delete
  rateTier      String   @default("standard") // "standard" | "premium"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  employee Employee @relation(fields: [empId], references: [id], onDelete: Cascade)
  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([empId, siteId, month, year, rateTier])
  @@index([empId])
  @@index([siteId])
  @@index([month])
  @@index([year])
  @@index([siteId, month, year])
  @@index([isPaid])
  @@index([rateTier])
  @@index([isDeleted])
  @@index([deletedAt])
}

model EmpCountSitePerMonth {
  id          String    @id @default(cuid())
  empId       String // FK to Employee
  empName     String
  siteId      String // FK to Site
  siteName    String
  month       String // YYYY-MM format
  createdDate DateTime  @default(now())
  removedDate DateTime?
  updatedDate DateTime  @updatedAt
  deletedDate DateTime? // Legacy soft-delete timestamp
  deletedAt   DateTime?

  employee Employee @relation(fields: [empId], references: [id], onDelete: Cascade)
  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([empId, siteId, month])
  @@index([empId])
  @@index([siteId])
  @@index([month])
  @@index([empId, siteId])
  @@index([deletedDate])
  @@index([deletedAt])
}

model SiteMonthActivation {
  id        String   @id @default(cuid())
  siteId    String // FK to Site
  month     String // YYYY-MM format
  year      Int
  createdAt DateTime @default(now())
  deletedAt DateTime?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, month, year])
  @@index([month, year])
  @@index([siteId])
  @@index([deletedAt])
}

model WorkLog {
  logId        Int      @id @default(autoincrement())
  employeeId   String // FK to Employee.id
  siteId       String // FK to Site.id
  year         Int
  month        Int // 1-12
  hoursWorked  Float    @default(0.00)
  allowances   Float    @default(0.00)
  deductions   Float    @default(0.00)
  deletedAt    DateTime? // soft delete (canonical)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([employeeId, siteId, year, month])
  @@index([employeeId, year, month], name: "idx_work_logs_chrono")
}

// ---------------------------------------------------------------------------
// Advance
// ---------------------------------------------------------------------------
// An Advance is a cash payment given to an employee ahead of salary.
// It is deducted from the employee's NEXT salary record.
//
// Lifecycle:
//   1. status = "pending"  — created via the Advance bucket UI, not yet applied
//   2. status = "applied"  — applied to a salary record (advance field set)
//   3. status = "cancelled" — admin cancelled before it was applied
//
// The "appliedToSalaryRecordId" field links the advance to the salary record
// it was deducted from, for traceability.
// ---------------------------------------------------------------------------
model Advance {
  id            String   @id @default(cuid())
  empId         String // FK to Employee.id
  empName       String
  employeeCode  String   @default("") // employee.employeeId (e.g. ASM-001)
  amount        Float    @default(0)
  reason        String   @default("")
  // Status:
  //   "pending"   — not yet applied (one-time advance waiting for salary save)
  //   "applied"   — fully deducted from salary (one-time advance, completed)
  //   "cancelled" — admin voided before applying
  //   "active"    — recurring advance, installments ongoing
  //   "completed" — recurring advance, fully repaid (remainingBalance <= 0)
  status        String   @default("pending")
  // Effective month/year: which salary month this advance should START being
  // deducted from.
  // Format: month = "YYYY-MM", year = integer.
  // Default: next month from creation date.
  effectiveMonth String  // YYYY-MM
  effectiveYear  Int
  // If applied (one-time) or last installment applied (recurring), link to
  // the salary record it was deducted from
  appliedToSalaryRecordId String?

  // ── Recurring deduction fields (only used when deductionType = "recurring") ──
  // deductionType:
  //   "one_time"  — the full `amount` is deducted in ONE month (effectiveMonth)
  //   "recurring" — `monthlyDeductionAmount` is deducted each month starting
  //                 from `effectiveMonth` until `remainingBalance` reaches 0
  //                 OR the `recurringUntil` month is reached (whichever first)
  deductionType           String  @default("one_time")
  monthlyDeductionAmount  Float?  // how much to deduct per month (recurring only)
  remainingBalance        Float?  // how much is left to repay (recurring only)
  // Optional END month for recurring deductions (INCLUSIVE — the deduction
  // still happens IN this month, then stops). Format "YYYY-MM".
  // null → deduct until remainingBalance reaches 0 (legacy behaviour).
  recurringUntil          String?

  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  employee    Employee            @relation(fields: [empId], references: [id], onDelete: Cascade)
  repayments  AdvanceRepayment[]

  @@index([empId])
  @@index([status])
  @@index([effectiveMonth, effectiveYear])
  @@index([effectiveYear])
  @@index([deletedAt])
  @@index([deductionType])
}

// ---------------------------------------------------------------------------
// AdvanceRepayment — tracks each monthly installment for recurring advances
// ---------------------------------------------------------------------------
// When a recurring advance has `monthlyDeductionAmount` deducted from a
// salary record, a repayment row is created linking the advance to the
// salary record and recording the amount deducted for that month.
//
// If the admin changes the monthly deduction amount mid-way, the new amount
// applies from the next month onward (previous repayments are unaffected).
// ---------------------------------------------------------------------------
model AdvanceRepayment {
  id              String   @id @default(cuid())
  advanceId       String   // FK to Advance.id
  empId           String   // denormalized for easy querying
  salaryRecordId  String?  // salary record this installment was deducted from
  month           String   // YYYY-MM — which salary month this installment covers
  year            Int
  amount          Float    // how much was deducted this month
  createdAt       DateTime @default(now())

  advance Advance @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  @@unique([advanceId, month]) // one installment per advance per month
  @@index([advanceId])
  @@index([empId, month])
  @@index([month, year])
}

// ---------------------------------------------------------------------------
// AttendanceShare
// ---------------------------------------------------------------------------
// A shareable, auth-free link that lets a Team Leader / Supervisor mark
// attendance for a single site on a single date.
//
// Lifecycle:
//   - status = "open"     : link is active and waiting for submission
//   - status = "submitted": attendance has been recorded via this link,
//                           further edits are blocked
//   - status = "expired"  : admin manually closed the link (no submission)
//
// The token is unguessable (cuid) and tied to a single site + date.
// Once submitted, the same link returns a "submitted" view-only page so
// the TL/Supervisor can confirm their entries were saved.
// ---------------------------------------------------------------------------
model AttendanceShare {
  id          String   @id @default(cuid())
  token       String   @unique // The unguessable share token (used in URL)
  siteId      String   // FK to Site.id
  siteName    String   // Denormalized for display
  clientName  String?  // Denormalized for the attendance sheet header
  projectName String?  // Denormalized for the attendance sheet header
  // The date the attendance is for (YYYY-MM-DD). The TL marks who was
  // present/absent on this specific date.
  date        String   // YYYY-MM-DD
  // Status: open (waiting), submitted (saved), expired (admin voided)
  status      String   @default("open")
  // When submitted, snapshot of what was marked (JSON array of
  // { employeeId, status } for audit / re-display).
  submittedSnapshot String?
  submittedById   String? // Employee.id of the TL/Sup who submitted (optional)
  submittedByName String? // Denormalized name
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime? // Optional expiry timestamp

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([date])
  @@index([status])
  @@index([token])
}

// ---------------------------------------------------------------------------
// AttendanceVersion
// ---------------------------------------------------------------------------
// A snapshot of the attendance for a single site on a single date, captured
// every time attendance is written (from the website, the public share link,
// or the bulk-mark route). Each version is immutable once written.
//
// Versions are linked to a share token when the change came in via a share
// link (so the Attendance Copy page can show per-link history). When the
// change came from the website admin UI, shareTokenId is null and source
// is 'website'.
//
// The Attendance Copy page lists all versions for a given site+date and
// lets the admin switch between them — switching does NOT change the live
// attendance; it just re-displays that version's snapshot. The admin can
// "Restore" a version, which writes a new version that copies the snapshot
// and updates the live attendance to match.
// ---------------------------------------------------------------------------
model AttendanceVersion {
  id           String   @id @default(cuid())
  siteId       String   // FK to Site.id
  siteName     String   // Denormalized
  date         String   // YYYY-MM-DD
  // The version number for this site+date. v1 is the first capture, v2 the
  // next, etc. Computed at write time by counting existing versions + 1.
  versionNumber Int
  // JSON snapshot of every employee's status at capture time:
  //   [{ "employeeId": "...", "fullName": "...", "employeeCode": "...",
  //      "status": "present" | "absent" | "no_site" | "overtime" | "not_marked",
  //      "overtimeHours": number | null }]
  snapshot     String
  // Where the change came from:
  //   - 'website'    : admin marked via the Attendance page
  //   - 'share_link' : TL/Supervisor submitted via /attendance/share/<token>
  //   - 'bulk_mark'  : admin used bulk-mark-present
  //   - 'restore'    : admin restored a previous version
  source       String   @default("website")
  // If source is 'share_link', the token of the share that submitted it.
  shareToken   String?
  // Who made the change (User.id for website/restore, or the submittedByName
  // for share_link). Stored as a free-text label for audit + the User.id
  // when known for the relation.
  changedById   String?
  changedByName String?
  // Brief label shown in the version history UI, e.g.
  //   "Marked 12 present, 3 absent via share link"
  summary      String
  createdAt    DateTime @default(now())

  site  Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([siteId, date, versionNumber])
  @@index([siteId, date])
  @@index([date])
  @@index([shareToken])
  @@index([changedById])
}

// ---------------------------------------------------------------------------
// ActivityLog
// ---------------------------------------------------------------------------
// A universal audit log. Every mutating action (create/update/delete) on any
// data in the app is recorded here with:
//   - who did it (userId + displayName — name if set, else email)
//   - what they did (action: create/update/delete/login/etc.)
//   - which entity was affected (entityType + entityId)
//   - a human-readable description (e.g. "Marked John Doe as present")
//   - a JSON snapshot of relevant details (optional, for context)
//   - timestamp
//
// The All Logs sidebar page groups these by user so an admin can see, per
// account holder, every activity they performed.
// ---------------------------------------------------------------------------
model ActivityLog {
  id           String   @id @default(cuid())
  // Who performed the action. userId may be null for system-generated actions
  // (e.g. auto-warnings) — in that case actorType is 'system'.
  userId       String?
  // Display name shown in the UI — prefers User.name, falls back to email.
  // Stored denormalized so the log still reads correctly even if the user is
  // later deleted.
  displayName  String
  actorType    String   @default("user") // "user" | "system"
  // What they did, e.g. "create", "update", "delete", "mark_attendance",
  // "bulk_mark", "share_link_submit", "login", "advance_create", etc.
  action       String
  // Which entity was affected, e.g. "employee", "site", "attendance",
  // "salary_record", "advance", "attendance_share", "user", etc.
  entityType   String
  entityId     String?
  entityName   String?  // Human-readable name of the affected entity
  // Human-readable summary, e.g. "Marked John Doe as present for 2026-07-15"
  description  String
  // Optional JSON details for context (before/after values, etc.)
  details      String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// TradeRate — custom hourly rate per trade
// ---------------------------------------------------------------------------
// Allows setting a single hourly rate for all employees with a given trade.
// For example, trade "Hilti" → rate 6.0 AED/hr. Every employee whose trade
// is "Hilti" gets this rate, overriding the standard 2.5/5.0 tier rates.
//
// Priority: employee.customHourlyRate > TradeRate > role-based rates
// ---------------------------------------------------------------------------

model TradeRate {
  id         String   @id @default(cuid())
  trade      String   @unique // e.g. "Hilti", "Mason", "Electrician", "Helper"
  hourlyRate Float   // e.g. 6.0 — same rate for below and above threshold
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employeeTrades EmployeeTrade[]

  @@index([trade])
}

// Junction table: links Employee to TradeRate.
// An employee can have ONE trade at a time (enforced by @@unique on employeeId).
// The trade is assigned from the Sites page (multi-select + dropdown).
// The rate comes from the linked TradeRate record.
// "Helper" is the default — uses threshold-based rates (2.5/5.0 or 3.0/5.5).
model EmployeeTrade {
  id          String   @id @default(cuid())
  employeeId  String   @unique // One trade per employee
  tradeRateId String
  assignedAt  DateTime @default(now())
  assignedBy  String?  // Admin name who assigned it

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tradeRate TradeRate @relation(fields: [tradeRateId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([tradeRateId])
}

// ---------------------------------------------------------------------------
// BaseRate — configurable base hourly rates (not hardcoded)
// ---------------------------------------------------------------------------
// Instead of hardcoding the pay tiers, these values are stored in the DB and
// can be edited from the Accounts page > "Manage Rates" button.
//
//   baseLow    — below-threshold base rate, applies to EVERY employee
//   helperHigh — above-threshold premium rate for Helpers (default 6.0)
//   tradeHigh  — above-threshold premium rate for other trades (default 7.0)
//
// There is only ONE row in this table (singleton). The app reads it on
// startup and uses the values everywhere rates are calculated.
//
// Priority: changelog override > employee.customHourlyRate > TradeRate
// (+0.5 if TL/Sup) > BaseRate (baseLow below threshold; helperHigh/tradeHigh
// above threshold depending on the employee's trade).
// ---------------------------------------------------------------------------
model BaseRate {
  id         String   @id @default("singleton")
  baseLow    Float    @default(3.5) // Below-threshold base rate (all employees)
  helperHigh Float    @default(6.0) // Above-threshold premium rate for Helpers
  tradeHigh  Float    @default(7.0) // Above-threshold premium rate for other trades
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// NocDocument — an issued No Objection Certificate (Documents > NOC)
// ---------------------------------------------------------------------------
// Each row is one generated NOC letter. The employee rows printed in the
// letter are SNAPSHOTTED into employeesJson at creation time (name, trade,
// company, nationality, passport) so the PDF can be regenerated byte-for-byte
// later even if employee records change or are deleted.
//
// Grouping: the Documents > NOC tab shows clients as folders; inside a
// client, NOCs are grouped by monthKey (YYYY-MM derived from nocDate).
// ---------------------------------------------------------------------------
model NocDocument {
  id            String   @id @default(cuid())
  nocNumber     String // system-generated, e.g. "NOC-2026-000001" (shared across versions)
  status        String   @default("draft") // "draft" | "final"
  version       Int      @default(1) // bumped when a FINAL NOC is edited (original PDF retained)
  clientName    String // e.g. "M/S PROSCAPE LLC" (folder grouping key, uppercased)
  projectName   String   @default("") // e.g. "ARABIAN RANCHES"
  clientAddress String   @default("") // address lines (newline separated)
  nocDate       String // date shown on the letter, DD-MM-YYYY
  monthKey      String // YYYY-MM — derived from nocDate, used for grouping
  contactPerson String   @default("Ms. Mafeeda Kader")
  contactPhone  String   @default("050 797 4153")
  contactEmail  String   @default("mafeedaarabianshieldmanpower@gmail.com")
  stampType     String   @default("procurement") // legacy: "procurement" | "signature" | "none" (pre stamp-picker rows)
  stampEnabled  Boolean  @default(false) // stamps are NOT applied automatically — toggled per NOC
  stampId       String? // which stamp (Stamp row) is applied when stampEnabled
  stampAppliedAt DateTime? // when the stamp was applied / last changed
  stampAppliedBy String? // admin display name who applied the stamp
  stampRect     String? // JSON {page,x,y,w,h} normalized 0..1 (y from page TOP) — where the renderer placed the stamp; shared with the FE animation (§36-38)
  companyId     String? // which company (NocCompany row) issues this NOC (letterhead + signature)
  employeesJson String // JSON array of { name, trade, company, nationality, passport }
  employeeCount Int      @default(0)
  currentStep   Int      @default(1) // workspace step the draft was left at (1..3) — exact resume point
  fileName      String // stored PDF file name, e.g. "NOC PROSCAPE ARABIAN RANCHES 02-09-2026.pdf"
  filePath      String? // relative path under storage/ — the PDF AS ISSUED, ALWAYS the unstamped original (never stamped on disk)
  originalFilePath String? // legacy companion of filePath (pre snapshot-model audit copy); normalized to filePath
  stampSnapshotPath String? // relative path under storage/ — snapshot of the STAMPED PDF captured when it was last DOWNLOADED (overwritten on each stamped download)
  createdBy     String? // admin display name
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  stamp   Stamp?      @relation(fields: [stampId], references: [id], onDelete: SetNull)
  company NocCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  packages NocDocumentPackage[]

  @@unique([nocNumber, version])
  @@index([clientName])
  @@index([status])
  @@index([nocDate])
  @@index([monthKey])
  @@index([createdAt])
  @@index([nocNumber])
  @@index([stampId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// NocCompany — issuing companies for NOC letters (multiple company names)
// ---------------------------------------------------------------------------
// The user has more than one legal entity; each NOC picks the company it is
// issued for. The company drives the signature block name, the {{company}}
// token in the body and (optionally) its own letterhead image. The manager
// contact of the company is printed in the letter footer exactly like the
// reference NOCs (name / phone / email).
// ---------------------------------------------------------------------------
model NocCompany {
  id             String   @id @default(cuid())
  name           String   @unique // signature block + body {{company}}, e.g. "ARABIAN SHIELD A/C. UNITS FIX. CONT"
  letterheadPath String? // optional per-company letterhead image under storage/letterheads/ (falls back to the default ASM letterhead)
  contactPerson  String   @default("Ms. Mafeeda Kader") // manager name for the footer block
  contactPhone   String   @default("050 797 4153") // manager number for the footer block
  contactEmail   String   @default("mafeedaarabianshieldmanpower@gmail.com") // manager email for the footer block
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  nocs   NocDocument[]
  stamps Stamp[]

  @@index([active])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Stamp — reusable stamps that can be applied to NOC letters
// ---------------------------------------------------------------------------
// Stamps live in the database (image stored under storage/stamps/); every NOC
// can choose WHICH stamp to apply and whether to apply one at all. The two
// reference stamps are seeded as built-ins after migration.
// ---------------------------------------------------------------------------
model Stamp {
  id        String   @id @default(cuid())
  name      String // display name, e.g. "Procurement", "Round signature"
  imagePath String // "builtin:stamp-procurement.png" | relative path under storage/stamps/
  companyId String? // owning company — a stamp is only valid for NOCs of that company (null = universal)
  mime      String   @default("image/png") // image mime (validated at upload; never trust the extension alone)
  isDefault Boolean  @default(false) // pre-selected for new NOCs
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  nocs     NocDocument[]
  company  NocCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// EmployeeDocument — scanned employee documents (Documents > Employee Documents)
// ---------------------------------------------------------------------------
// Passport / Emirates ID / visa scans plus any other documents. Binary files
// live under storage/employee-documents/; this row holds metadata only.
// docType: "passport" | "id_card" | "visa" | "other"
// ---------------------------------------------------------------------------
model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  docType    String   @default("other")
  docName    String // display name (editable, e.g. "Passport 2026 scan")
  fileName   String // original upload file name
  filePath   String // relative path under storage/
  mimeType   String   @default("application/pdf")
  fileSize   Int      @default(0)
  status     String   @default("ACTIVE") // ACTIVE | REPLACED | DELETED | INVALID — only ACTIVE feeds latest-valid selection (§52)
  expiryDate String? // optional ISO date (YYYY-MM-DD) for expiry tracking
  notes      String? // optional free-text note
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([docType])
  @@index([expiryDate])
  @@index([status])
}

// ---------------------------------------------------------------------------
// NocDocumentPackage — generated NOC ZIP packages (audit + cache)
// ---------------------------------------------------------------------------
// One row per generated package: the outer ZIP holds the NOC PDF plus one
// nested ZIP per NOC employee with their latest valid documents. status
// tracks GENERATING/COMPLETED/FAILED so the UI can show the last package.
// ---------------------------------------------------------------------------
model NocDocumentPackage {
  id                String   @id @default(cuid())
  nocId             String
  fileName          String // e.g. "NOC_PROSCAPE_ARABIAN_RANCHES_02-09-2026.zip"
  storagePath       String? // relative path under storage/noc-packages/
  fileSize          Int      @default(0)
  employeeCount     Int      @default(0)
  documentsIncluded Int      @default(0) // total employee docs packaged
  documentsMissing  Int      @default(0) // total category slots with no valid doc
  summaryJson       String?  @default("{}") // per-employee/per-category detail for the UI summary
  status            String   @default("GENERATING") // GENERATING | COMPLETED | FAILED
  generatedBy       String?
  createdAt         DateTime @default(now())

  noc NocDocument @relation(fields: [nocId], references: [id], onDelete: Cascade)

  @@index([nocId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// NocTemplate — admin-controlled NOC letter configuration (singleton)
// ---------------------------------------------------------------------------
// Keeps the approved legal wording and signatory block out of the code so
// admins can update them without a redeploy. The body text supports a
// {{company}} placeholder which is rendered bold (the contractor name).
// ---------------------------------------------------------------------------
model NocTemplate {
  id            String   @id @default("singleton")
  bodyText      String   @default("We would like the following workers of our organization to work with your company. Our company takes full responsibility for our workers as regards to their salary, welfare and any other requirements. In case of any injury or untoward incident at site we M/s {{company}}., take all Liabilities & Claims and take full responsibility for our workers.")
  companyName   String   @default("ARABIAN SHIELD A/C. UNITS FIX. CONT")
  contactPerson String   @default("Ms. Mafeeda Kader")
  contactPhone  String   @default("050 797 4153")
  contactEmail  String   @default("mafeedaarabianshieldmanpower@gmail.com")
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// AI Assistant chat persistence — one fresh session is auto-created per user
// per calendar day (Asia/Dubai). Previous days remain accessible from the
// assistant's session rail (ChatGPT-style history).
// ---------------------------------------------------------------------------
model AiChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String // "YYYY-MM-DD" (Asia/Dubai) — unique per user, drives the daily fresh chat
  title     String   @default("New chat") // derived from the first question of the session
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiChatMessage[]

  @@unique([userId, day])
  @@index([userId, updatedAt])
}

model AiChatMessage {
  id        String        @id @default(cuid())
  sessionId String
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime      @default(now())

  @@index([sessionId, createdAt])
}
